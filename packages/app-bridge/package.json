{
	"name": "@app/bridge",
	"version": "1.0.0-dev.0",
	"description": "bridge between electron and browser",
	"license": "MIT",
	"files": [
		"dist/**"
	],
	"type": "module",
	"exports": {
		"./electron": {
			"import": "./dist/electron.mjs",
			"types": "./dist/electron.d.mts"
		},
		"./preload": {
			"import": "./dist/preload.mjs",
			"types": "./dist/preload.d.mts"
		},
		"./browser": {
			"import": "./dist/browser.js",
			"types": "./dist/browser.d.ts"
		}
	},
	"scripts": {
		"lint": "oxlint && oxfmt --check",
		"build": "tsdown"
	},
	"dependencies": {
		"@orpc/contract": "1.14.13"
	},
	"devDependencies": {
		"@app/shared": "workspace:*",
		"tsdown": "catalog:"
	},
	"peerDependencies": {
		"@orpc/client": "catalog:",
		"@orpc/server": "catalog:",
		"electron": "catalog:",
		"zod": "catalog:"
	},
	"peerDependenciesMeta": {
		"@orpc/client": {
			"optional": true
		},
		"@orpc/server": {
			"optional": true
		}
	}
}
