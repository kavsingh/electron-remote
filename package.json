{
	"name": "electron-remote",
	"version": "0.0.0",
	"private": true,
	"description": "electron remote monorepo setup",
	"keywords": [],
	"license": "MIT",
	"author": "<author>",
	"repository": {
		"type": "git",
		"url": "git@github.com:kavsingh/electron-remote"
	},
	"type": "module",
	"scripts": {
		"dev": "conc 'pnpm dev:frontend' 'pnpm dev:electron'",
		"dev:frontend": "pnpm turbo run dev --filter app-frontend",
		"dev:electron": "wait-on http://localhost:5321 && pnpm turbo run dev --filter app-electron",
		"lint": "turbo run lint",
		"test": "turbo run test",
		"test:ci": "turbo run test:ci",
		"test:e2e": "turbo run test:e2e --filter app-e2e",
		"build:mac": "turbo run build:mac --filter app-electron",
		"serve:frontend-prod": "docker compose up app-frontend-prod",
		"clean:turbo": "rimraf ./**/.turbo --glob"
	},
	"devDependencies": {
		"@tsconfig/node24": "24.0.6",
		"@tsconfig/strictest": "2.0.9",
		"@types/node": "26.6.6",
		"@types/wait-on": "5.3.4",
		"@typescript/native-preview": "npm:typescript@7.0.2",
		"code-config": "workspace:*",
		"concurrently": "10.0.7",
		"cross-env": "10.1.0",
		"dotenv": "18.0.10",
		"lefthook": "2.2.2",
		"oxfmt": "catalog:",
		"oxlint": "catalog:",
		"oxlint-tsgolint": "catalog:",
		"repo": "workspace:*",
		"rimraf": "6.1.4",
		"turbo": "2.11.13",
		"typescript": "npm:@typescript/typescript6@6.0.2",
		"wait-on": "catalog:"
	},
	"engines": {
		"node": ">=24"
	},
	"packageManager": "pnpm@12.23.0+sha512.02da94ffaf133f46074322afe552f90d40b5f71ae259aefbccdacc5085b1d617e98d65e0131f5748b9b67445978ee5055d7d59a473f1eef0d504854fefcd5975"
}
