{
	"name": "electron-remote",
	"version": "0.0.0",
	"private": true,
	"description": "electron remote monorepo setup",
	"keywords": [],
	"license": "MIT",
	"author": "<author>",
	"repository": {
		"type": "git",
		"url": "git@github.com:kavsingh/electron-remote"
	},
	"type": "module",
	"scripts": {
		"dev": "conc 'pnpm dev:frontend' 'pnpm dev:electron'",
		"dev:frontend": "pnpm turbo run dev --filter app-frontend",
		"dev:electron": "wait-on http://localhost:5321 && pnpm turbo run dev --filter app-electron",
		"lint": "turbo run lint",
		"test": "turbo run test",
		"test:ci": "turbo run test:ci",
		"test:e2e": "turbo run test:e2e --filter app-e2e",
		"build:mac": "turbo run build:mac --filter app-electron",
		"serve:frontend-prod": "docker compose up app-frontend-prod",
		"clean:turbo": "rimraf ./**/.turbo --glob"
	},
	"devDependencies": {
		"@eslint/core": "1.2.1",
		"@tsconfig/node24": "24.0.5",
		"@tsconfig/strictest": "2.0.8",
		"@types/node": "24.13.5",
		"@types/wait-on": "5.3.4",
		"@typescript/native-preview": "npm:typescript@7.0.2",
		"code-config": "workspace:*",
		"concurrently": "10.0.5",
		"cross-env": "10.1.0",
		"dotenv": "18.0.0",
		"lefthook": "2.1.14",
		"oxfmt": "catalog:",
		"oxlint": "catalog:",
		"oxlint-tsgolint": "catalog:",
		"repo": "workspace:*",
		"rimraf": "6.1.3",
		"turbo": "2.10.13",
		"typescript": "npm:@typescript/typescript6@6.0.2",
		"wait-on": "catalog:"
	},
	"engines": {
		"node": ">=24"
	},
	"packageManager": "pnpm@12.5.1+sha512.e3f305bc784a2bc89f5ad3b6138889470fae8d2af5f36b61216ec91c2c3d64089775f9de38aac331044ea40f245cb0d5666392dfdf65824e1907ef6a2c62de5f"
}
