{
	"name": "electron-remote",
	"version": "0.0.0",
	"private": true,
	"description": "electron remote monorepo setup",
	"keywords": [],
	"license": "MIT",
	"author": "<author>",
	"repository": {
		"type": "git",
		"url": "git@github.com:kavsingh/electron-remote"
	},
	"type": "module",
	"scripts": {
		"dev": "conc 'pnpm dev:frontend' 'pnpm dev:electron'",
		"dev:frontend": "pnpm turbo run dev --filter app-frontend",
		"dev:electron": "wait-on http://localhost:5321 && pnpm turbo run dev --filter app-electron",
		"lint": "turbo run lint",
		"test": "turbo run test",
		"test:ci": "turbo run test:ci",
		"test:e2e": "turbo run test:e2e --filter app-e2e",
		"build:mac": "turbo run build:mac --filter app-electron",
		"serve:frontend-prod": "docker compose up app-frontend-prod",
		"clean:turbo": "rimraf ./**/.turbo --glob"
	},
	"devDependencies": {
		"@eslint/core": "1.2.1",
		"@tsconfig/node24": "24.0.4",
		"@tsconfig/strictest": "2.0.8",
		"@types/node": "24.13.2",
		"@types/wait-on": "5.3.4",
		"@typescript/native-preview": "npm:typescript@7.0.2",
		"code-config": "workspace:*",
		"concurrently": "10.0.4",
		"cross-env": "10.1.0",
		"dotenv": "17.4.2",
		"lefthook": "2.1.10",
		"oxfmt": "catalog:",
		"oxlint": "catalog:",
		"oxlint-tsgolint": "catalog:",
		"repo": "workspace:*",
		"rimraf": "6.1.3",
		"turbo": "2.10.8",
		"typescript": "npm:@typescript/typescript6@6.0.2",
		"wait-on": "catalog:"
	},
	"engines": {
		"node": ">=24"
	},
	"packageManager": "pnpm@11.21.0+sha512.521705bce689924eac72f5a3587122f362689ef6571e55ba80076fd637c11132ecffada26fad4ea79c485bfddbfd3d5a2a5b05805a77e893de71ec8a6cca3bb1"
}
